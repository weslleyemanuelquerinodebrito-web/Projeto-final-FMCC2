from itertools import product

# minha parte: associatividade e comutatividade
# ideia geral: pra cada uma, testa tudo e para assim que acha um erro
# (não precisa continuar procurando depois de já saber que falhou)


def verifica_comutatividade(tabela, n):
    """
    testa se ab = ba pra todo mundo.
    para na primeira violação (não precisa ficar catando todas)

    devolve um dict tipo:
    {
        "propriedade": "comutatividade",
        "valida": bool,
        "primeira_violacao": {...} ou None
    }
    """
    for i in range(n):
        for j in range(i + 1, n):
            ij = tabela[i][j]
            ji = tabela[j][i]

            if ij != ji:
                return {
                    "propriedade": "comutatividade",
                    "valida": False,
                    "primeira_violacao": {"a": i, "b": j, "a*b": ij, "b*a": ji},
                }

    return {
        "propriedade": "comutatividade",
        "valida": True,
        "primeira_violacao": None,
    }


def verifica_associatividade(tabela, n):
    """
    testa se (ab)c = a(bc) pra toda combinação de a, b, c.
    mesma lógica: para assim que acha a primeira quebra.

    devolve:
    {
        "propriedade": "associatividade",
        "valida": bool,
        "primeira_violacao": {...} ou None
    }
    """
    for i, j, k in product(range(n), repeat=3):
        ij_k = tabela[tabela[i][j]][k]
        i_jk = tabela[i][tabela[j][k]]

        if ij_k != i_jk:
            return {
                "propriedade": "associatividade",
                "valida": False,
                "primeira_violacao": {"a": i, "b": j, "c": k, "(a*b)*c": ij_k, "a*(b*c)": i_jk},
            }

    return {
        "propriedade": "associatividade",
        "valida": True,
        "primeira_violacao": None,
    }


def verifica_parte_hector(tabela, n, eh_grupo=True):
    """
    junta as duas verificações acima num dict só, pra ficar fácil
    de encaixar com o resto do grupo (fechamento, elemento neutro, inversos)

    só faz sentido checar comutatividade se já for grupo, então tem
    o parâmetro eh_grupo pra pular essa parte quando não for o caso
    """
    return {
        "associatividade": verifica_associatividade(tabela, n),
        "comutatividade": verifica_comutatividade(tabela, n) if eh_grupo else None,
    }


def formata_relatorio(resultado, nomes=None):
    """
    pega o dict de verifica_parte_hector e transforma em texto
    (separei isso da lógica de verificação pra ficar mais organizado)
    """
    linhas = []
    adjetivo = {"comutatividade": "comutativa", "associatividade": "associativa"}

    for chave in ("associatividade", "comutatividade"):
        r = resultado.get(chave)
        if r is None:
            continue  # não é grupo, então nem checou comutatividade

        if r["valida"]:
            linhas.append(f"A operação é {adjetivo[chave]}.")
            continue

        v = r["primeira_violacao"]
        linhas.append(f"A operação não é {adjetivo[chave]}.")

        if chave == "comutatividade":
            a, b = v["a"], v["b"]
            nome_a = nomes[a] if nomes else a
            nome_b = nomes[b] if nomes else b
            linhas.append(f"  Achei isso: {nome_a} * {nome_b} = {v['a*b']}, mas {nome_b} * {nome_a} = {v['b*a']}")
        else:  # associatividade
            a, b, c = v["a"], v["b"], v["c"]
            nome_a = nomes[a] if nomes else a
            nome_b = nomes[b] if nomes else b
            nome_c = nomes[c] if nomes else c
            linhas.append(
                f"  Achei isso: ({nome_a} * {nome_b}) * {nome_c} = {v['(a*b)*c']}, "
                f"mas {nome_a} * ({nome_b} * {nome_c}) = {v['a*(b*c)']}"
            )

    return "\n".join(linhas)


